# db-ops connection string template. Copy to <project root>/.dbops/.env (project-level, takes priority) or ~/.dbops/.env (global).
# One connection per line: <name>=<full connection string> (address + account + password — the connection's entire identity)
# Type is inferred from the scheme; environment is inferred from the host; gitignore this file + chmod 600
LOCAL=postgres://user:devpass@localhost:5432/dbname
REMOTE=postgres://user:pass@host.example.net:5432/dbname
