---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import InstallCard from '../components/InstallCard.astro';
import { useTranslations, formatDate } from '../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('zhArticles');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = useTranslations('zh');
const base = import.meta.env.BASE_URL;

const slug = post.slug;
const enCounterpart = (await getCollection('enArticles')).find((e) => e.slug === slug) ?? null;
---

<Base
  lang="zh"
  title={post.data.title}
  description={post.data.description}
  enHref={enCounterpart ? `${base}en/${slug}/` : null}
>
  <article>
    <nav class="px-6 text-sm text-zinc-500">
      <a href={`${base}`} class="inline-flex items-center transition hover:text-zinc-900" aria-label="Fei skills">
        <svg class="h-[1em] w-[1em] text-[#ff4d6d]" viewBox="0 0 8 7" aria-hidden="true">
          <g fill="currentColor">
            <rect x="1" y="0" width="1" height="1"/><rect x="2" y="0" width="1" height="1"/><rect x="4" y="0" width="1" height="1"/><rect x="5" y="0" width="1" height="1"/>
            <rect x="0" y="1" width="1" height="1"/><rect x="1" y="1" width="1" height="1"/><rect x="2" y="1" width="1" height="1"/><rect x="3" y="1" width="1" height="1"/><rect x="4" y="1" width="1" height="1"/><rect x="5" y="1" width="1" height="1"/><rect x="6" y="1" width="1" height="1"/>
            <rect x="0" y="2" width="1" height="1"/><rect x="1" y="2" width="1" height="1"/><rect x="2" y="2" width="1" height="1"/><rect x="3" y="2" width="1" height="1"/><rect x="4" y="2" width="1" height="1"/><rect x="5" y="2" width="1" height="1"/><rect x="6" y="2" width="1" height="1"/>
            <rect x="1" y="3" width="1" height="1"/><rect x="2" y="3" width="1" height="1"/><rect x="3" y="3" width="1" height="1"/><rect x="4" y="3" width="1" height="1"/><rect x="5" y="3" width="1" height="1"/>
            <rect x="2" y="4" width="1" height="1"/><rect x="3" y="4" width="1" height="1"/><rect x="4" y="4" width="1" height="1"/>
            <rect x="3" y="5" width="1" height="1"/>
          </g>
        </svg>
      </a>
      <span class="mx-1.5 text-zinc-300">/</span>
      <span class="font-medium text-zinc-800">{slug}</span>
    </nav>
    <h1 class="mt-4 px-6 text-3xl font-extrabold leading-tight">{post.data.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-3 px-6 text-sm text-zinc-500">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'zh')}</time>
      {post.data.tags.map((tag) => (
        <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600">{tag}</span>
      ))}
    </div>
    <InstallCard install={post.data.install} copiedText={t('install.copied')} />
    <div class="prose prose-zinc max-w-none px-6">
      <Content />
    </div>
  </article>
</Base>
