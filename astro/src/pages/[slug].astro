---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import InstallCard from '../components/InstallCard.astro';
import { useTranslations, formatDate } from '../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('zhArticles');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = useTranslations('zh');
const base = import.meta.env.BASE_URL;

const slug = post.slug;
const enCounterpart = (await getCollection('enArticles')).find((e) => e.slug === slug) ?? null;
---

<Base
  lang="zh"
  title={post.data.title}
  description={post.data.description}
  enHref={enCounterpart ? `${base}en/${slug}/` : null}
>
  <article>
    <nav class="text-sm text-zinc-500">
      <a href={`${base}`} class="transition hover:text-zinc-900">{t('site.title')}</a>
      <span class="mx-1.5 text-zinc-300">/</span>
      <span class="font-medium text-zinc-800">{slug}</span>
    </nav>
    <h1 class="mt-4 text-3xl font-extrabold leading-tight">{post.data.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-zinc-500">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'zh')}</time>
      {post.data.tags.map((tag) => (
        <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600">{tag}</span>
      ))}
    </div>
    <InstallCard install={post.data.install} copiedText={t('install.copied')} />
    <div class="prose prose-zinc max-w-none">
      <Content />
    </div>
  </article>
</Base>
