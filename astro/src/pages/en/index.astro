---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { useTranslations, formatDate } from '../../i18n/ui';

const t = useTranslations('en');
const base = import.meta.env.BASE_URL;

const articles = (await getCollection('enArticles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base lang="en" title={t('site.title')} description={t('site.subtitle')}>
  <section class="mb-8">
    <h1 class="font-display text-3xl font-extrabold tracking-tight">{t('site.title')}</h1>
    <p class="my-8 text-sm leading-relaxed text-zinc-500" set:html={t('site.subtitle')} />
  </section>

  {articles.length === 0 ? (
    <p class="text-zinc-500">{t('list.empty')}</p>
  ) : (
    <div class="space-y-4">
      {articles.map((a) => (
        <ArticleCard
          href={`${base}en/${a.slug}/`}
          title={a.data.title}
          date={formatDate(a.data.pubDate, 'en')}
          datetime={a.data.pubDate.toISOString()}
          description={a.data.description}
          original={a.data.original}
          originalText={t('label.original')}
          sharedText={t('label.shared')}
          skillName={a.data.skill_name}
          author={a.data.author}
          readMore={t('read.more')}
        />
      ))}
    </div>
  )}

  <section class="mt-16">
    <h2 class="text-lg font-bold">{t('about.title')}</h2>
    <p class="mt-3 text-sm leading-relaxed text-zinc-600" set:html={t('about.body')} />
  </section>
</Base>
