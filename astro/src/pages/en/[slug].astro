---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InstallCard from '../../components/InstallCard.astro';
import { useTranslations, formatDate } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('enArticles');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = useTranslations('en');
const base = import.meta.env.BASE_URL;

const slug = post.slug;
const zhCounterpart = (await getCollection('zhArticles')).find((z) => z.slug === slug) ?? null;
---

<Base
  lang="en"
  title={post.data.title}
  description={post.data.description}
  zhHref={zhCounterpart ? `${base}${slug}/` : null}
>
  <article>
    <nav class="text-sm text-zinc-500">
      <a href={`${base}en/`} class="transition hover:text-zinc-900">Fei♡skills</a>
      <span class="mx-1.5 text-zinc-300">/</span>
      <span class="font-medium text-zinc-800">{slug}</span>
    </nav>
    <h1 class="mt-4 text-3xl font-extrabold leading-tight">{post.data.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-zinc-500">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'en')}</time>
      {post.data.tags.map((tag) => (
        <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600">{tag}</span>
      ))}
    </div>
    <InstallCard install={post.data.install} copiedText={t('install.copied')} />
    <div class="prose prose-zinc max-w-none">
      <Content />
    </div>
  </article>
</Base>
