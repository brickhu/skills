---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { useTranslations, formatDate } from '../i18n/ui';

const t = useTranslations('zh');
const base = import.meta.env.BASE_URL;

const articles = (await getCollection('zhArticles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 根路径默认锁定英文版；用户切换语言后记住选择（localStorage）
const autoLangScript = `
  var _base = ${JSON.stringify(base)};
  var _path = window.location.pathname;
  if (_path === _base || _path === _base.replace(/\\/$/, '')) {
    var _saved = null;
    try { _saved = localStorage.getItem('fei-skills-lang'); } catch (e) {}
    if (_saved !== 'zh') {
      window.location.replace(_base + 'en/');
    }
  }
`;
---

<Base lang="zh" title={t('site.title')} description={t('site.subtitle')}>
  <Fragment slot="head">
    <script is:inline set:html={autoLangScript} />
  </Fragment>
  <section class="mb-8 text-center sm:text-left">
    <h1 class="font-display flex items-center justify-center gap-1.5 text-3xl font-extrabold tracking-tight sm:justify-start">
      FEI
      <svg class="h-[0.75em] w-[0.75em]" viewBox="0 0 8 7" aria-hidden="true">
        <g fill="#ff4d6d">
          <rect x="1" y="0" width="1" height="1"/><rect x="2" y="0" width="1" height="1"/><rect x="4" y="0" width="1" height="1"/><rect x="5" y="0" width="1" height="1"/>
          <rect x="0" y="1" width="1" height="1"/><rect x="1" y="1" width="1" height="1"/><rect x="2" y="1" width="1" height="1"/><rect x="3" y="1" width="1" height="1"/><rect x="4" y="1" width="1" height="1"/><rect x="5" y="1" width="1" height="1"/><rect x="6" y="1" width="1" height="1"/>
          <rect x="0" y="2" width="1" height="1"/><rect x="1" y="2" width="1" height="1"/><rect x="2" y="2" width="1" height="1"/><rect x="3" y="2" width="1" height="1"/><rect x="4" y="2" width="1" height="1"/><rect x="5" y="2" width="1" height="1"/><rect x="6" y="2" width="1" height="1"/>
          <rect x="1" y="3" width="1" height="1"/><rect x="2" y="3" width="1" height="1"/><rect x="3" y="3" width="1" height="1"/><rect x="4" y="3" width="1" height="1"/><rect x="5" y="3" width="1" height="1"/>
          <rect x="2" y="4" width="1" height="1"/><rect x="3" y="4" width="1" height="1"/><rect x="4" y="4" width="1" height="1"/>
          <rect x="3" y="5" width="1" height="1"/>
        </g>
      </svg>
      SKILLS
    </h1>
    <p class="my-8 text-sm leading-relaxed text-zinc-500" set:html={t('site.subtitle')} />
  </section>

  {articles.length === 0 ? (
    <p class="text-zinc-500">{t('list.empty')}</p>
  ) : (
    <div class="space-y-4">
      {articles.map((a) => (
        <ArticleCard
          href={`${base}${a.slug}/`}
          title={a.data.title}
          date={formatDate(a.data.pubDate, 'zh')}
          datetime={a.data.pubDate.toISOString()}
          description={a.data.description}
          original={a.data.original}
          originalText={t('label.original')}
          sharedText={t('label.shared')}
          skillName={a.data.skill_name}
        />
      ))}
    </div>
  )}

  <section class="mt-16 text-center sm:text-left">
    <h2 class="text-lg font-bold">{t('about.title')}</h2>
    <p class="mt-3 text-sm leading-relaxed text-zinc-600" set:html={t('about.body')} />
  </section>
</Base>
