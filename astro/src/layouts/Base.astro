---
import { useTranslations, type Lang } from '../i18n/ui';
import LangSwitch from '../components/LangSwitch.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  zhHref?: string | null;
  enHref?: string | null;
}

const { title, description, lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const homeHref = lang === 'en' ? `${base}en/` : `${base}`;
const zhHref = Astro.props.zhHref ?? `${base}`;
const enHref = Astro.props.enHref ?? `${base}en/`;
const pageTitle = title === t('site.title') ? t('site.title') : `${title} · ${t('site.title')}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? ''} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased">
    <header class="border-b border-zinc-200 bg-white">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-5">
        <a href={homeHref} class="flex items-center gap-2 text-lg font-extrabold tracking-tight">
          <span aria-hidden="true">🧩</span> {t('site.title')}
        </a>
        <nav class="flex items-center gap-4">
          <LangSwitch lang={lang} zhHref={zhHref} enHref={enHref} />
          <a href="https://github.com/brickhu" target="_blank" rel="noopener" class="text-sm text-zinc-500 transition hover:text-zinc-900">GitHub</a>
          <a href="https://x.com/fei1919" target="_blank" rel="noopener" class="text-sm text-zinc-500 transition hover:text-zinc-900">X</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl px-4 pb-10 text-center text-sm text-zinc-400">
      {t('footer')}
    </footer>
  </body>
</html>
