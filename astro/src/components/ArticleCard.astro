---
interface Props {
  href: string;
  title: string;
  date: string;
  datetime: string;
  description: string;
  original: boolean;
  originalText: string;
  sharedText: string;
  skillName: string;
  author: string;
  readMore: string;
}

const { href, title, date, datetime, description, original, originalText, sharedText, skillName, author, readMore } = Astro.props;
---

<article class="group rounded-2xl bg-white p-6 transition hover:shadow-sm">
  <a href={href} class="block">
    <div class="mb-2 flex flex-wrap items-center gap-1.5 text-sm text-zinc-500">
      <span class={original ? 'font-medium text-emerald-600' : 'font-medium text-sky-600'}>
        {original ? originalText : sharedText}
      </span>
      <span class="text-zinc-300">•</span>
      <span class="font-bold text-zinc-700">/{skillName}</span>
      <span>by</span>
      <span class="text-zinc-600">{author}</span>
    </div>
    <h2 class="font-display text-xl font-bold leading-snug transition group-hover:text-zinc-600">{title}</h2>
    <p class="mt-2 line-clamp-2 text-sm text-zinc-600">{description}</p>
    <div class="mt-3 flex items-center justify-between">
      <span class="text-sm font-medium text-zinc-800 group-hover:underline">{readMore}</span>
      <time datetime={datetime} class="text-xs text-zinc-400">{date}</time>
    </div>
  </a>
</article>
