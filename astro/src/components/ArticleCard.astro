---
interface Props {
  href: string;
  title: string;
  date: string;
  datetime: string;
  description: string;
  original: boolean;
  originalText: string;
  sharedText: string;
  skillName: string;
}

const { href, title, date, datetime, description, original, originalText, sharedText, skillName } = Astro.props;
---

<article class="group rounded-2xl border border-zinc-200 bg-white p-6 transition hover:border-zinc-400">
  <a href={href} class="block">
    <div class="mb-2 flex flex-wrap items-center gap-1.5 text-sm text-zinc-500">
      <span class="font-bold text-zinc-700">/{skillName}</span>
      <span class="text-zinc-300">•</span>
      <span class={original ? 'font-medium text-emerald-600' : 'font-medium text-sky-600'}>
        {original ? originalText : sharedText}
      </span>
    </div>
    <h2 class="text-xl font-bold leading-snug transition group-hover:text-zinc-600">{title}</h2>
    <p class="mt-2 line-clamp-2 text-sm text-zinc-600">{description}</p>
    <div class="mt-3 flex items-center justify-between">
      <time datetime={datetime} class="text-xs text-zinc-400">{date}</time>
      <span class="text-lg text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-zinc-800" aria-hidden="true">→</span>
    </div>
  </a>
</article>
