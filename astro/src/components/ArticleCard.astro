---
interface Props {
  href: string;
  title: string;
  date: string;
  datetime: string;
  description: string;
  tags?: string[];
  readMore: string;
}

const { href, title, date, datetime, description, tags = [], readMore } = Astro.props;
---

<article class="group rounded-2xl border border-zinc-200 bg-white p-6 transition hover:border-zinc-400 hover:shadow-sm">
  <a href={href} class="block">
    <div class="mb-2 flex flex-wrap items-center gap-3 text-sm text-zinc-500">
      <time datetime={datetime}>{date}</time>
      {tags.map((tag) => (
        <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600">{tag}</span>
      ))}
    </div>
    <h2 class="text-xl font-bold leading-snug transition group-hover:text-zinc-600">{title}</h2>
    <p class="mt-2 line-clamp-2 text-sm text-zinc-600">{description}</p>
    <span class="mt-3 inline-block text-sm font-medium text-zinc-800 group-hover:underline">{readMore}</span>
  </a>
</article>
