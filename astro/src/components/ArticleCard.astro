---
interface Props {
  href: string;
  title: string;
  date: string;
  datetime: string;
  description: string;
  original: boolean;
  originalText: string;
  sharedText: string;
  skillName: string;
}

const { href, title, date, datetime, description, original, originalText, sharedText, skillName } = Astro.props;
---

<article class="group rounded-2xl border border-transparent bg-white p-6 transition hover:border-zinc-300">
  <a href={href} class="block">
    <div class="mb-2 flex flex-wrap items-center gap-1.5 text-sm text-zinc-500">
      <span class="flex items-center gap-1">
        <svg class="h-[1em] w-[1em] text-zinc-400" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M0 0h24v24H0z" fill="none" />
          <path fill="currentColor" fill-rule="evenodd" d="m3 5l2-2l16 16l-2 2zm10 0l1-2l1 2l2 1l-2 1l-1 2l-1-2l-2-1zM5 15l1-2l1 2l2 1l-2 1l-1 2l-1-2l-2-1zM4 9l1 1l-1 1l-1-1zm14 1l1 1l-1 1l-1-1z" />
        </svg>
        <span class="font-bold text-zinc-700">{skillName}</span>
      </span>
      <span class="text-zinc-300">•</span>
      <span class={original ? 'font-medium text-pink-500' : 'font-medium text-amber-400'}>
        {original ? originalText : sharedText}
      </span>
    </div>
    <h2 class="text-lg font-bold leading-snug transition group-hover:text-zinc-600">{title}</h2>
    <p class="mt-2 line-clamp-2 text-sm text-zinc-600">{description}</p>
    <div class="mt-3 flex items-center justify-between">
      <time datetime={datetime} class="text-xs text-zinc-400">{date}</time>
      <span class="text-lg text-zinc-400 transition group-hover:translate-x-0.5 group-hover:text-zinc-800" aria-hidden="true">→</span>
    </div>
  </a>
</article>
