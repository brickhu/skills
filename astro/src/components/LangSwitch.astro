---
import { languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  zhHref: string | null;
  enHref: string | null;
}

const { lang, zhHref, enHref } = Astro.props;
const targetLang: Lang = lang === 'zh' ? 'en' : 'zh';
const targetHref = lang === 'zh' ? enHref : zhHref;
---

{targetHref ? (
  <a
    href={targetHref}
    class="rounded-full border border-zinc-300 px-3 py-1 text-sm text-zinc-600 transition hover:border-zinc-500 hover:text-zinc-900"
  >
    {languages[targetLang]}
  </a>
) : (
  <span class="cursor-not-allowed text-sm text-zinc-300">{languages[targetLang]}</span>
)}
