---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  zhHref: string | null;
  enHref: string | null;
}

const { lang, zhHref, enHref } = Astro.props;
---

<span class="relative inline-flex items-center">
  <select
    class="cursor-pointer appearance-none rounded-full border border-zinc-300 bg-transparent pl-2.5 pr-[1.25em] text-sm font-medium text-zinc-500 transition hover:border-zinc-500 hover:text-zinc-900 focus:outline-none"
    aria-label="Language"
    data-lang-select
  >
    <option value={zhHref ?? ''} selected={lang === 'zh'}>CN</option>
    <option value={enHref ?? ''} selected={lang === 'en'}>EN</option>
  </select>
  <svg class="pointer-events-none absolute right-0 h-2.5 w-2.5 text-zinc-400" viewBox="0 0 12 12" fill="none" aria-hidden="true">
    <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</span>

<script>
  const selects = document.querySelectorAll<HTMLSelectElement>('[data-lang-select]');
  selects.forEach((select) => {
    select.addEventListener('change', () => {
      const href = select.value;
      if (href) window.location.href = href;
    });
  });
</script>
